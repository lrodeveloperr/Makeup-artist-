{
  "name": "makeup-artist-",
  "version": "1.0.0",
  "description": "WorksBien Studios freestyle makeup game: build contract and the generated-face prototype.",
  "scripts": {
    "fetch:makehuman": "node tools/makehuman/fetch.mjs",
    "build:head": "node tools/makehuman/build-head.mjs",
    "build:preview": "node tools/build-preview.mjs --minify",
    "serve": "node tools/serve.mjs build/preview",
    "audit": "node tests/face-audit.mjs 2000 300",
    "test": "node tests/unit.mjs && node tests/face-audit.mjs 2000 300 && node tests/size-budget.mjs",
    "test:render": "node tools/build-preview.mjs && node tests/render-smoke.mjs",
    "size": "node tests/size-budget.mjs"
  },
